# Server-only. Create an API key at https://www.pexels.com/api/.
PEXELS_API_KEY=
GOOGLE_FONTS_API_KEY=

# Public Convex deployment URL. Created by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL. Created by `npx convex dev`.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Convex deployment selector. Keep the generated value in .env.local.
CONVEX_DEPLOYMENT=
